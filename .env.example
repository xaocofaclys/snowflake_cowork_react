# ---------- Mode ----------
# dev   = local login, no Snowflake needed (pair with CORTEX_MOCK=true and APP_STORE=file)
# oauth = Snowflake OAuth per user (see snowflake/03_oauth.sql)
AUTH_MODE=dev
CORTEX_MOCK=true
# file = .data/db.json (offline) | snowflake = COWORK_APP.CORE tables via the service user
APP_STORE=file
# Optional; without it an in-memory cache and in-process jobs are used.
# REDIS_URL=redis://localhost:6379

PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- Snowflake ----------
# SNOWFLAKE_ACCOUNT_URL=https://myorg-myaccount.snowflakecomputing.com
# SNOWFLAKE_ACCOUNT=MYORG-MYACCOUNT
SNOWFLAKE_WAREHOUSE=COWORK_WH
SNOWFLAKE_ROLE=COWORK_USER

# OAuth (AUTH_MODE=oauth)
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:4000/auth/callback

# Service user (APP_STORE=snowflake and background LLM jobs): key-pair or PAT
# SNOWFLAKE_SERVICE_USER=COWORK_SVC
# SNOWFLAKE_SERVICE_PRIVATE_KEY_PATH=./cowork_svc.p8
# SNOWFLAKE_SERVICE_PAT=
SNOWFLAKE_SERVICE_ROLE=COWORK_APP_SERVICE
APP_DATABASE=COWORK_APP
APP_SCHEMA=CORE

# Where to discover agents (comma-separated DB.SCHEMA). Empty = SHOW AGENTS IN ACCOUNT.
AGENT_LOCATIONS=DEV_REACT_COWORK.AGENTS

# Cortex LLM functions for memory extraction, chart fallback and titles
LLM_MODEL=llama3.1-70b
EMBED_MODEL=snowflake-arctic-embed-m-v1.5
ARTIFACT_CACHE_TTL=300

# Route Planner agent; its FR_* procedures and tables live in the same schema
PLANNER_AGENT=DEV_REACT_COWORK.AGENTS.FIELD_REP_DAY_PLANNER
